        "# ============================ CELL 4 · GRID: three learning rates per baseline at the primary seed, chosen on VAL AUROC (mean of horizons, soup) ============================\n",
        "REC, GRID = {}, {}\n",
        "CHOICE_PATH = REP_PATH(\"06_lr_choice.json\"); CHOICE = json.load(open(CHOICE_PATH)) if os.path.exists(CHOICE_PATH) else {}\n",
        "def train(fam, lr, seed, role):\n",
        "    nm = bname(fam, lr, seed)\n",
        "    try: REC[nm] = runs.train_model(B, nm, baselines.hp_for(fam, HP, lr), seed=seed, role=role); return REC[nm]\n",
        "    except RuntimeError as e:\n",
        "        if \"diverged\" not in str(e) and \"no epoch finished\" not in str(e): raise\n",
        "        print(f\"[{nm}] did not train: {str(e)[:160]}\"); tracking.end_active_runs(); return None\n",
        "if STAGES[\"grid\"]:\n",
        "    for fam in FAMS:\n",
        "        GRID[fam] = {}\n",
        "        for lr in LR_GRID:\n",
        "            r = train(fam, lr, PRIMARY, \"benchmark_lr_grid\"); GRID[fam][f\"{lr:g}\"] = None if r is None else dict(auroc=r[\"metrics\"][\"auroc_mean\"], auprc=r[\"metrics\"][\"auprc_mean\"], epochs=r[\"epochs_run\"])\n",
        "        ok = {k: v for k, v in GRID[fam].items() if v is not None}\n",
        "        if not ok: print(f\"{fam}: no learning rate of the grid trained\"); continue\n",
        "        if fam not in CHOICE: CHOICE[fam] = max(sorted(ok, key=float), key=lambda k: ok[k][\"auroc\"])       # ties -> the smaller learning rate\n",
        "        print(f\"{baselines.LABELS[fam]:<40s} \" + \" | \".join(f\"lr {k}: \" + (\"failed\" if v is None else f\"AUROC {v['auroc']:.4f} AUPRC {v['auprc']:.4f} ({v['epochs']} ep)\") for k, v in GRID[fam].items()) + f\"  -> chosen lr {CHOICE[fam]}\")\n",
        "    json.dump(CHOICE, open(CHOICE_PATH, \"w\"), indent=1)"
      ]
